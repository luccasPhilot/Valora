# Variáveis de produção. Copie para infra/.env no servidor e preencha. O .env nunca vai para o git.
# A change deploy-home-server completa esta lista (banco, porta, fuso); lista completa em docs/05-deploy.md.

# Credenciais da sua aplicação no dashboard do Pluggy (aba "Aplicação").
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Ids dos itens (um por banco conectado pelo MeuPluggy), separados por vírgula: id1,id2,id3.
PLUGGY_ITEM_IDS=
# Horário da sincronização diária, no fuso America/Sao_Paulo (formato cron). Padrão: 07:00.
SYNC_CRON=0 7 * * *
