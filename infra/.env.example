# Variáveis de produção. Copie para infra/.env no servidor e preencha. O .env nunca vai para o git.
# O que não aparece aqui (banco, porta, fuso, endereço do banco) é fixo no infra/compose.yml.

# Senha do PostgreSQL. Gere uma longa só com letras e números, para não quebrar o endereço
# do banco que o compose monta: openssl rand -hex 24
POSTGRES_PASSWORD=

# Credenciais da sua aplicação no dashboard do Pluggy (aba "Aplicação").
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Ids dos itens (um por banco conectado pelo MeuPluggy), separados por vírgula: id1,id2,id3.
PLUGGY_ITEM_IDS=
# Horário da sincronização diária, no fuso America/Sao_Paulo (formato cron). Padrão: 07:00.
SYNC_CRON=0 7 * * *
# fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info

# Avisos de falha pelo healthchecks.io (opcionais; docs/05-deploy.md, "Avisos de falha").
# Cada uma é a URL de ping de um check (https://hc-ping.com/<uuid>). Vazia: nada é enviado.
# Só https. A URL é segredo (quem a tem manda sinais falsos): nunca vai para o git nem para o log.
# O aviso leva só ok ou falha, nunca dados do banco.
# Backup semanal + conferência da restauração (weekly-backup.sh).
HEALTHCHECK_BACKUP_URL=
# Sincronização diária agendada (o backend lê esta; o botão "Sincronizar agora" não avisa).
HEALTHCHECK_SYNC_URL=
# Uso do disco acima de 85% (disk-check.sh).
HEALTHCHECK_DISK_URL=

# Notificações push no iPhone e no computador (opcionais; docs/05-deploy.md, "Notificações push").
# Ou as três, ou nenhuma: só parte delas impede a API de subir. Sem elas, o push fica desligado.
# Gere o par de chaves uma vez com `npm run push:keys` (na pasta backend). As chaves nunca vão para o git nem para o log.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# O endereço do app na tailnet (https://...ts.net), não um e-mail pessoal.
VAPID_SUBJECT=
