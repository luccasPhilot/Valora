# Variáveis de produção. Copie para infra/.env no servidor e preencha. O .env nunca vai para o git.
# O que não aparece aqui (banco, porta, fuso, endereço do banco) é fixo no infra/compose.yml.

# Senha do PostgreSQL. Gere uma longa só com letras e números, para não quebrar o endereço
# do banco que o compose monta: openssl rand -hex 24
POSTGRES_PASSWORD=

# Credenciais da sua aplicação no dashboard do Pluggy (aba "Aplicação").
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Ids dos itens (um por banco conectado pelo MeuPluggy), separados por vírgula: id1,id2,id3.
PLUGGY_ITEM_IDS=
# Horário da sincronização diária, no fuso America/Sao_Paulo (formato cron). Padrão: 07:00.
SYNC_CRON=0 7 * * *
# fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info
