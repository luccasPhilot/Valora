# Variáveis do backend em desenvolvimento.
# Copie para backend/.env e preencha. O .env nunca vai para o git.
# Cada change acrescenta aqui as variáveis de que precisa (lista completa em docs/05-deploy.md).

# Conexão com o PostgreSQL. O valor abaixo bate com o infra/compose.dev.yml (senha só de desenvolvimento).
DATABASE_URL=postgres://valora:valora_dev@127.0.0.1:5432/valora
# Endereço e porta em que a API escuta. Em desenvolvimento fica só na sua máquina; no Docker, o compose usa 0.0.0.0.
HOST=127.0.0.1
PORT=3000
# fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info
# Fuso do processo; as datas do Valora usam sempre America/Sao_Paulo.
TZ=America/Sao_Paulo

# Credenciais da sua aplicação no dashboard do Pluggy (aba "Aplicação"). Nunca vão para o git.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Ids dos itens (um por banco conectado pelo MeuPluggy), separados por vírgula: id1,id2,id3.
# Como achar: docs/02-open-finance.md.
PLUGGY_ITEM_IDS=
# Horário da sincronização diária, no fuso America/Sao_Paulo (formato cron). Padrão: 07:00.
SYNC_CRON=0 7 * * *
